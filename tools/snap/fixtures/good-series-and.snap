# good: two switches in a row. The lamp needs BOTH.
kits scb20
grid 7x5 grid-mini
step 1: grid
step 2: B3B at 1A dir=right side=up level=1
step 3: S1 at 1C dir=down level=1
step 4: S2 at 3E dir=up level=1
step 5: L4 at 5C dir=up level=1
step 6: wire3 at 1A dir=down level=2
step 7: wire3 at 1E dir=right level=2
step 8: wire3 at 3C dir=right level=2
step 9: wire3 at 5A dir=left level=2
expect S1=on, S2=pressed: L4 on
expect S1=on, S2=released: L4 off
expect S1=off, S2=pressed: L4 off
expect S1=off, S2=released: L4 off
