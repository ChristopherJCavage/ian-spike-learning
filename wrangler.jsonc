{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stem-builds",
  "compatibility_date": "2026-11-24",
  // Public on the custom domain. workers.dev stays off so deploy does not
  // stop to register a workers.dev subdomain. There is no Access gate.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "stem.galaxymoose.com", "custom_domain": true }]
}
