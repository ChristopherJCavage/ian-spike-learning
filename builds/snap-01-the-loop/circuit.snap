# The Night Skate Cases -- Spark Detectives, Module 1.
# Cases 1-3 use the Beginner box (SCB-20) only. Case 4 needs a fifth blue
# 3-snap wire, and the Beginner box has four, so the extra one comes from
# the Jr box (SC-100). This build needs both boxes.
#
# Measured from Chris's photos (renders/real-*.jpg). Posts are column then
# row: 1A is top-left, numbers 1-7 across, letters A-E down.
#
# Every block here is 1x3: it spans three posts with its two snaps on the
# end posts. The battery holder (B3B) is 3x3 and rides the top edge: its
# snap row sits on row A (+ on 1A, - on 3A) and the rest of the case, with
# the batteries, hangs off the top of the board.
#
# The loop: + at 1A, down the wire to 1C, through the switch to 1E, along
# row E to 3E, up through the light (3E to 3C), up the wire to 3A, - at 3A.
# Current enters the light at 3E. D10's + is its offset-0 end:
#   + at 3C (as built): current goes in the other end, so it is YELLOW.
#   + at 3E (flip=4):   current goes in at the +, so it is RED.
# W1 honks only with its + at 3E (current in at the +).
#
# Loads sit at level 1. The wires snap on top of them at level 2. Blocks
# only stack at a shared end snap and leave it in different directions.
kits scb20, sc100
grid 7x5 grid-mini

step 1: grid
step 2: B3B at 1A dir=right side=up level=1
step 3: S1 at 1C dir=down level=1
step 4: D10 at 3C dir=down level=1
step 5: wire3 at 1A dir=down level=2
step 6: wire3 at 1E dir=right level=2
step 7: wire3 at 3C dir=up level=2
step 8: egg at 3C

# ---- Case 1: The Dark Skate Park. D10 under the egg, + at 3C: yellow.
scene watch: S1=on
puzzle c1-a: S1=on, remove=5
puzzle c1-b: S1=on
puzzle c1-c: S1=off
expect S1=off: D10 off
expect S1=on: D10 yellow
expect S1=on, remove=5: D10 off
expect S1=on, remove=6: D10 off
expect S1=on, remove=7: D10 off
photo c1: renders/real-c1.jpg
  board: S1=off
  parts: B3B 1A+ 3A, wire3 1A 1C, S1 1C 1E, wire3 1E 3E, D10 3C+ 3E, egg on D10, wire3 3C 3A

# ---- Case 2: The Colour-Changing Light. Turn D10 around: + at 3E, red.
change colours: flip=4
scene red: base=colours, S1=on
puzzle c2-a: S1=on
puzzle c2-b: base=colours, S1=on
puzzle c2-c: base=colours, S1=off
expect base=colours, S1=on: D10 red
expect base=colours, S1=off: D10 off

# ---- Case 3: The horn. Press switch in the gate's spot, horn in the
# light's spot with its + on 3E (the bottom snap, under the blue tube).
# The egg only fits on D10, so it comes off.
change horn: swap=3/S2, swap=4/W1, flip=4
scene silent: base=horn, S2=pressed
change horn-fixed: swap=3/S2, swap=4/W1, flip=4
scene honk: base=horn-fixed, S2=pressed
puzzle c3-a: base=horn-fixed, S2=released
puzzle c3-b: base=horn, S2=pressed, flip=4
puzzle c3-c: base=horn-fixed, S2=pressed
expect base=horn, S2=pressed: W1 on
expect base=horn, S2=pressed, flip=4: W1 off
expect base=horn-fixed, S2=pressed: W1 on
expect base=horn-fixed, S2=released: W1 off
photo c3: renders/real-c3.jpg
  board: base=horn-fixed, S2=released
  parts: B3B 1A+ 3A, wire3 1A 1C, S2 1C 1E, wire3 1E 3E, W1 3E+ 3C, wire3 3C 3A

# ---- Case 4: The Two Lights. The red light (D10, + on 3E, egg on) and
# the white light (L4) side by side. L4 stands on 5C-5E. One wire joins
# the bottom ends (3E to 5E) and one the top ends (3C to 5C). They snap
# on top of the wires already at 3E and 3C, so they sit at level 3; their
# other ends sit on L4 at level 2 (a one-level tilt the real snaps take).
# After the slide gate the water splits: one stream through each light.
# The fifth blue wire comes from the Jr box.
change c4-red: flip=4
change c4-lamp: base=c4-red, part=9/L4@5E/up/1
change c4-tube1: base=c4-lamp, part=10/wire3@3E/right/3
change c4-tube2: base=c4-tube1, part=11/wire3@3C/right/3
scene c4-both: base=c4-tube2, S1=on
puzzle c4-a: base=c4-tube2, S1=on
puzzle c4-b: base=c4-tube2, S1=off
puzzle c4-c: base=c4-tube2, S1=on, remove=11
expect base=c4-lamp, S1=on: L4 off
expect base=c4-lamp, S1=on: D10 red
expect base=c4-tube1, S1=on: L4 off
expect base=c4-tube2, S1=on: L4 on
expect base=c4-tube2, S1=on: D10 red
expect base=c4-tube2, S1=off: L4 off
expect base=c4-tube2, S1=off: D10 off
expect base=c4-tube2, S1=on, remove=11: L4 off
expect base=c4-tube2, S1=on, remove=11: D10 red
expect base=c4-tube2, S1=on, flip=4: D10 yellow
expect base=c4-tube2, S1=on, flip=4: L4 on
photo c4-off: renders/real-c4-off.jpg
  board: base=c4-tube2, S1=off
  parts: B3B 1A+ 3A, wire3 1A 1C, S1 1C 1E, wire3 1E 3E, D10 3E+ 3C, egg on D10, wire3 3C 3A, L4 5E 5C, wire3 3E 5E, wire3 3C 5C
  shows: D10 off, L4 off
photo c4-on: renders/real-c4-on.jpg
  board: base=c4-tube2, S1=on
  parts: B3B 1A+ 3A, wire3 1A 1C, S1 1C 1E, wire3 1E 3E, D10 3E+ 3C, egg on D10, wire3 3C 3A, L4 5E 5C, wire3 3E 5E, wire3 3C 5C
  shows: D10 red, L4 on

# ---- Case 5: The Big Night. Three missions. The answers are the photo boards.
mission yellow-gate: S1=on => S1=on: D10 yellow; S1=off: D10 off
mission red-button: swap=3/S2, flip=4 => S2=pressed: D10 red; S2=released: D10 off
mission both-lights: base=c4-tube2 => S1=on: D10 red; S1=on: L4 on; S1=off: L4 off; S1=off: D10 off
photo c5-yellow: renders/real-c5-yellow.jpg
  board: S1=on
  parts: B3B 1A+ 3A, wire3 1A 1C, S1 1C 1E, wire3 1E 3E, D10 3C+ 3E, egg on D10, wire3 3C 3A
  shows: D10 yellow
photo c5-red: renders/real-c5-red.jpg
  board: base=red-button, S2=pressed
  parts: B3B 1A+ 3A, wire3 1A 1C, S2 1C 1E, wire3 1E 3E, D10 3E+ 3C, egg on D10, wire3 3C 3A
  shows: D10 red
